# Raspberry Pi Audio Scheduler - Environment Variables
# Copy to .env or /etc/raspi-audio-scheduler/app.env and adjust as needed.

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080

# IANA timezone for interpreting schedule times (e.g. "Asia/Tokyo").
# Empty = use the system's local timezone.
APP_TIMEZONE=Asia/Tokyo

# Data directory (mounted into the backend container)
DATA_DIR=/var/lib/raspi-audio-scheduler

# SQLite database path (relative to DATA_DIR when not absolute)
DATABASE_URL=sqlite:////var/lib/raspi-audio-scheduler/database/app.db

# --- NTP ---
NTP_PRIMARY=ntp.nict.jp
NTP_SECONDARY=time.cloudflare.com
NTP_TERTIARY=time.google.com
NTP_INTERVAL=300
NTP_TIMEOUT=5

# --- VOICEVOX ---
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_TIMEOUT=10

# Voice generation is prefetched this many seconds before playback
VOICE_PREFETCH_SECONDS=600

# Prefetch retry schedule (seconds before playback, comma separated)
VOICE_PREFETCH_RETRIES=600,300,120,30

# --- Audio Agent ---
AUDIO_AGENT_URL=http://127.0.0.1:8031

# --- Logging ---
LOG_LEVEL=INFO
