[Unit]
Description=Raspberry Pi Audio Agent (host-side audio output)
After=pipewire.service pipewire-pulse.service network.target
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
User=audio-scheduler
Group=audio
WorkingDirectory=/opt/raspi-audio-scheduler/audio-agent
ExecStart=/usr/bin/python3 -m audio_agent
Restart=always
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/var/lib/raspi-audio-scheduler

# PipeWire/ALSA access
SupplementaryGroups=audio video pipewire

[Install]
WantedBy=multi-user.target
