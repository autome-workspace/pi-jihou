[Unit]
Description=Raspberry Pi Audio Scheduler (backend + frontend + voicevox via Docker)
Requires=docker.service
After=docker.service network-online.target raspi-audio-agent.service
Wants=network-online.target raspi-audio-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/raspi-audio-scheduler
ExecStart=/usr/bin/docker compose up -d backend frontend voicevox
ExecStop=/usr/bin/docker compose down
EnvironmentFile=/etc/raspi-audio-scheduler/app.env

[Install]
WantedBy=multi-user.target
